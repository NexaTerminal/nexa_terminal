# Nexa Terminal — server environment (example). Copy to .env and fill in.

# --- Core ---
NODE_ENV=development
PORT=5002
MONGODB_URI=mongodb://localhost:27017/nexa
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
CSRF_SECRET=change-me
ADMIN_SETUP_KEY=change-me

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5002/api/auth/google/callback

# Founder invite — single reusable secret that grants INSTANT Pro on leads.nexa.mk.
# The canonical invite link is  https://leads.nexa.mk/join?t=<this value>
# Rotate the link by changing this; freeze all new Pro signups by leaving it blank.
LEADS_FOUNDER_INVITE_TOKEN=

# --- Email (Resend + Gmail fallback) ---
RESEND_API_KEY=
FROM_EMAIL=info@nexa.mk
ADMIN_EMAIL=
GMAIL_APP_PASSWORD=

# --- URLs / CORS ---
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:5002
CORS_ORIGINS=http://localhost:3000

# --- Rate limiting / misc ---
RATE_LIMIT_GENERAL=
RATE_LIMIT_AUTH=
RATE_LIMIT_UPLOAD=
MAX_REQUEST_SIZE=
LOG_LEVEL=info
NEXA_ALL_FEATURES=

# --- AI models (OpenAI) ---
OPENAI_API_KEY=sk-...
# Everything defaults to gpt-5-mini in code; set these only to override a role.
OPENAI_MODEL=gpt-5-mini              # main answers: Лекс, Вера, Стојан, LHC narrative, contract analysis
OPENAI_UTILITY_MODEL=gpt-5-mini      # utility: query condensation/decomposition, rerank, JSON extraction, summaries
OPENAI_MARKETING_MODEL=gpt-5-mini    # Миа (marketing)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small  # DO NOT change without re-indexing Qdrant
# Optional per-feature overrides (default to the role above):
#   CONTRACT_ANALYSIS_MODEL, CONTRACT_PRESCAN_MODEL, CASE_BRIEF_MODEL,
#   INTERVIEW_SUMMARY_MODEL, BLOG_GUIDELINE_MODEL, CHATBOT_WEB_MODEL
CHATBOT_MAX_PROMPTS_PER_WEEK=4
CHATBOT_MAX_TOKENS=8000              # output cap (floored on reasoning models so reasoning can't starve the answer)
# Reasoning effort per role (gpt-5-mini): minimal | low | medium | high
AI_EFFORT_MAIN=low
AI_EFFORT_UTILITY=minimal
AI_EFFORT_MARKETING=low
# NOTE: do NOT set CHATBOT_TEMPERATURE — reasoning models reject temperature.
# Rollback: set OPENAI_MODEL=gpt-4o (and/or the role vars) to go back to a
# non-reasoning model; the code re-enables temperature/max_tokens automatically.

# --- Qdrant vector DB ---
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=nexa_legal_docs
# Insurance collection (Стојан) override, defaults to nexa_insurance_docs:
# QDRANT_INSURANCE_COLLECTION_NAME=nexa_insurance_docs

# --- Legal Data Hunter (optional) ---
LDH_API_KEY=
LDH_BASE_URL=
LDH_ENABLED=
